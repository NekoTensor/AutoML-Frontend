# Copy this file to `.env.local` and point it at your running FastAPI backend.
# Local dev (backend running via `uvicorn app:app --reload --port 8000`):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (backend deployed on an HF Space):
# NEXT_PUBLIC_API_URL=https://your-username-automl-backend.hf.space
